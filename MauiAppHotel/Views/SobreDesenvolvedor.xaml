<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.SobreDesenvolvedor"
             Title="Sobre o Desenvolvedor"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="SOBRE O DESENVOLVEDOR"
                   FontFamily="BebasNeue"
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="20"
                   CornerRadius="20"
                   HasShadow="True"
                   BackgroundColor="{StaticResource White}">

                <VerticalStackLayout Spacing="20">

                    <Frame HeightRequest="130"
                           WidthRequest="130"
                           CornerRadius="65"
                           Padding="0"
                           IsClippedToBounds="True"
                           HasShadow="False"
                           BackgroundColor="{StaticResource White}"
                           HorizontalOptions="Center">

                        <Image Source="developer.png"
                               Aspect="AspectFill" />
                    </Frame>

                    <Label Text="Engenheira de Software Java, mãe de pet e de gente, louca dos gatos."
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Gray500}" />

                    <Frame Padding="15"
                           CornerRadius="15"
                           BackgroundColor="{StaticResource Gray100}">

                        <VerticalStackLayout Spacing="15">

                            <HorizontalStackLayout Spacing="12">

                                <Image HeightRequest="20" WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE7FD;"
                                                         FontFamily="MaterialIcons"
                                                         Color="{StaticResource Primary}"
                                                         Size="20" />
                                    </Image.Source>
                                </Image>

                                <Label Text="Nome: Bruna Celestino"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="12">

                                <Image HeightRequest="20" WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE8DF;"
                                                         FontFamily="MaterialIcons"
                                                         Color="{StaticResource Primary}"
                                                         Size="20" />
                                    </Image.Source>
                                </Image>

                                <Label Text="Ano: 2026"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="12">

                                <Image HeightRequest="20" WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE86F;"
                                                         FontFamily="MaterialIcons"
                                                         Color="{StaticResource Primary}"
                                                         Size="20" />
                                    </Image.Source>
                                </Image>

                                <Label Text=".NET MAUI"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="12">

                                <Image HeightRequest="20" WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE0BE;"
                                                         FontFamily="MaterialIcons"
                                                         Color="{StaticResource Primary}"
                                                         Size="20" />
                                    </Image.Source>
                                </Image>

                                <Label Text="brunaccelestino@email.com"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="Voltar"
                            Clicked="Button_Clicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50" />

                </VerticalStackLayout>
            </Frame>

            <Label Text="© 2026 - Todos os direitos reservados"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>