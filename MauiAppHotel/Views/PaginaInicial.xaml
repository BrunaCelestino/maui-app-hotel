<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:MauiAppHotel.Models"
             x:Class="MauiAppHotel.Views.PaginaInicial"
             Title="Hotel Paradise"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#1E1E1E}">

    <ScrollView>

        <VerticalStackLayout Padding="10"
                             Spacing="5">

            <Label Text="Hotel Paradise"
                   FontFamily="BebasNeue"
                   FontSize="50"
                   TextTransform="Uppercase"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <Button Text="Contratar Hospedagem"
                    Clicked="ContratarHospedagem_Clicked"/>

            <CollectionView x:Name="cv_quartos">

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="model:Quarto" >

                        <VerticalStackLayout>
                            <Border Padding="10"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="White"
                                    Stroke="#E0E0E0"
                                    Margin="0,10,0,0" >

                            <VerticalStackLayout Spacing="10">

                                <Image Source="{Binding Imagem}"
                                       HeightRequest="230"
                                       Aspect="AspectFill"
                                        />

                                <Label Text="{Binding Descricao}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding DescricaoCompleta}"
                                       FontSize="14"/>

                                <Button Text="Saiba Mais"
                                        Clicked="SaibaMais_Clicked"
                                        CommandParameter="{Binding .}"/>

                            </VerticalStackLayout>

                        </Border>
                        </VerticalStackLayout>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <Label
                  Text="Sobre"
                  FontSize="14"
                  TextColor="{StaticResource Primary}"
                  HorizontalOptions="Center"
                  FontAttributes="Bold"
                  TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Sobre_Clicked"/>
                    </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>