<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.QuartoPage"
             BackgroundColor="{StaticResource Gray200}">

    <ScrollView>

        <VerticalStackLayout Padding="15"
                             Spacing="15">

            <Image x:Name="img_quarto"
                   HeightRequest="250"
                   Aspect="AspectFill"/>

            <Label x:Name="lbl_titulo"
                   FontFamily="BebasNeue"
                   FontSize="45"
                   TextTransform="Uppercase"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Descrição"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Label x:Name="lbl_descricao"
                           FontSize="16"/>

                    <Label x:Name="lbl_valorAdulto"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Label x:Name="lbl_valorCrianca"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Button Text="Contratar Hospedagem"
                            Clicked="Button_Clicked"/>

                    <Button Text="Voltar" 
                            Clicked="Button_Back_Clicked" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>