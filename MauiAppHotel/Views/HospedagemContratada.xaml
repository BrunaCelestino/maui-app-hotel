<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray200}">

    <ScrollView>
        <VerticalStackLayout Padding="15"
                             Spacing="15"
                             VerticalOptions="CenterAndExpand">

            <Label Text="RESERVA CONFIRMADA"
                   FontFamily="BebasNeue"
                   FontSize="46"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="20"
                   CornerRadius="18"
                   HasShadow="True"
                   BackgroundColor="{StaticResource White}">

                <VerticalStackLayout Spacing="18">

                    <Label Text="{Binding QuartoSelecionado.Descricao}"
                           FontSize="28"
                           FontFamily="BebasNeue"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />

                    <Frame Padding="12"
                           CornerRadius="12"
                           BackgroundColor="{StaticResource Gray100}">

                        <Grid ColumnDefinitions="*,*">

                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center">
                                <Label Text="Adultos"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding QntAdultos}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="Center">
                                <Label Text="Crianças"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding QntCriancas}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>

                    <Frame Padding="12"
                           CornerRadius="12"
                           BackgroundColor="{StaticResource Gray100}">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="PERÍODO DA ESTADIA"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="Check-in" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="Check-out" />

                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="Diárias" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       TextColor="{StaticResource Primary}" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       TextColor="{StaticResource Primary}" />

                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding Estadia}"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <Frame Padding="12"
                           CornerRadius="12"
                           BackgroundColor="{StaticResource Secondary}">

                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="Valor Total: "
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}"
                                   FontSize="18"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>

                    </Frame>

                    <Button Text="Voltar"
                            Clicked="Button_Clicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>